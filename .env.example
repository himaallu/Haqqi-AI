# Copy to .env and fill in. Never commit .env.

# Primary LLM: K2 Horizon hosted API (OpenAI-compatible)
K2_API_KEY=
K2_BASE_URL=https://api.ifm.ai/v1
K2_MODEL=IFM/K2-Horizon-375B-A23B

# Backup LLM + Whisper speech-to-text: Groq free tier (OpenAI-compatible)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Postgres + pgvector (docker-compose default below; Supabase URL in production)
DATABASE_URL=postgresql://haqqi:haqqi@localhost:5432/haqqi

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Frontend: where the browser reaches the backend
NEXT_PUBLIC_API_URL=http://localhost:8000
